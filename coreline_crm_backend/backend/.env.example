# MongoDB Database Connection
DATABASE_URL="mongodb://localhost:27017/crm_db"

# JWT Secret
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Port
PORT=7834

# Bind to all interfaces so the server is reachable behind nginx / from the network
HOST=0.0.0.0

# Frontend URL(s) for CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,https://frontend-theta-eight-84.vercel.app,https://crm.corelineitsolutions.com"

# Office Location (for geofencing)
OFFICE_LAT="28.6139"
OFFICE_LNG="77.2090"
GEOFENCE_RADIUS="100"

# Email Configuration
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"
EMAIL_FROM="noreply@yourcompany.com"

# Node Environment
NODE_ENV="development"
